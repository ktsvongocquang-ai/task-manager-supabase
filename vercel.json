{
    "crons": [
        {
            "path": "/api/generate-grok-news",
            "schedule": "0 0 * * *"
        },
        {
            "path": "/api/generate-grok-news?job=zalo",
            "schedule": "0 2 * * *"
        },
        {
            "path": "/api/generate-grok-news?job=zalo",
            "schedule": "35 6 * * *"
        },
        {
            "path": "/api/generate-grok-news?job=zalo",
            "schedule": "30 10 * * *"
        }
    ],
    "functions": {
        "api/khai-toan/pdf.js": {
            "maxDuration": 30,
            "includeFiles": "public/khai-toan/{calc.js,print-template.js,fonts/*.ttf}"
        }
    },
    "rewrites": [
        {
            "source": "/api/fb-ads-reports",
            "destination": "/api/fb-ads-analyze"
        },
        {
            "source": "/(.*)",
            "destination": "/index.html"
        }
    ],
    "images": {
        "sizes": [300, 600, 700, 800, 900, 1000, 1200, 1600, 1920],
        "formats": ["image/avif", "image/webp"],
        "minimumCacheTTL": 31536000,
        "remotePatterns": [
            { "protocol": "https", "hostname": "*.supabase.co" }
        ]
    },
    "headers": [
        {
            "source": "/(.*)",
            "headers": [
                { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
            ]
        },
        {
            "source": "/assets/(.*)",
            "headers": [
                { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
            ]
        }
    ]
}
